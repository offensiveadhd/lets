{
  "lip": 1,
  "name": "mini",
  "version": "0.0.1",
  "title": "Mini — test fixture",
  "description": "The smallest valid unique; used by the engine's tests.",
  "entry": "ui/index.html",
  "guide": "GUIDE.md",
  "domains": [
    "mini"
  ],
  "capabilities": [
    "entity",
    "chat"
  ],
  "events": {
    "mini.ping": {
      "summary": "test ping"
    },
    "mini.snapshot": {
      "summary": "reply to mini.snapshot"
    },
    "mini.export": {
      "summary": "the human sent the window to Claude (handoff)"
    }
  },
  "commands": {
    "mini.snapshot": {
      "summary": "ask for a snapshot"
    },
    "mini.load": {
      "summary": "rebuild the window from a saved payload"
    }
  },
  "permissions": {
    "fs.write": [
      "uploads"
    ],
    "net": []
  },
  "license": "MIT",
  "session": {
    "export": "mini.export",
    "snapshot": "mini.snapshot",
    "restore": "mini.load"
  }
}
