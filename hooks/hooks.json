{
  "description": "lets: deliver window events to Claude on every prompt",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/drain.mjs\"",
            "timeout": 5,
            "statusMessage": "lets: collecting window events"
          }
        ]
      }
    ]
  }
}
